{
  "name": "client_update",
  "title": "Update Client",
  "description": "Centrally triggers an OTA update to the latest certified release on a selected HHC client.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68
      },
      "force": {
        "type": "boolean",
        "description": "Force update even if the client is already on latest certified version."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "in_progress",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "job_id": {
        "type": "string"
      },
      "target_version": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  }
}
