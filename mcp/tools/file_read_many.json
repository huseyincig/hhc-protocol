{
  "name": "file_read_many",
  "title": "Read Multiple Files",
  "description": "Reads up to 10 files in one call. More efficient than repeated file_read; prefer it for multi-file review.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "paths"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 4096
        },
        "minItems": 1,
        "maxItems": 10,
        "description": "Absolute paths on the selected client."
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65536,
        "default": 65536,
        "description": "Per-file byte cap."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "completed on success, failed on error.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "client_id": {
        "type": "string",
        "description": "Echo of the target host id (null when no host was targeted)."
      },
      "job_id": {
        "type": "string",
        "description": "Server job handle for this execution."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Execution time in milliseconds."
      },
      "result": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Absolute path that was read (or attempted)."
                },
                "content": {
                  "type": "string",
                  "description": "UTF-8 content up to max_bytes."
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Total file size in bytes."
                },
                "truncated": {
                  "type": "boolean",
                  "description": "Whether content was cut at max_bytes."
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Per-file error code, null on success."
                }
              }
            },
            "description": "Per-file results in request order."
          }
        },
        "description": "Agent payload for this execution."
      },
      "error": {
        "type": "string",
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
