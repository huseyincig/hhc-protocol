{
  "name": "file_read_many",
  "title": "Read Multiple Files",
  "description": "Reads up to 10 files in one call. More efficient than repeated file_read; prefer it for multi-file review.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "paths"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 4096
        },
        "minItems": 1,
        "maxItems": 10,
        "description": "Absolute paths on the selected client."
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65536,
        "default": 65536,
        "description": "Per-file byte cap."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
