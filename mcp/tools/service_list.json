{
  "name": "service_list",
  "title": "List Services",
  "description": "Lists services known to the selected client (systemd/SCM/launchd abstracted). Prefer this over platform-specific service commands.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "services": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
