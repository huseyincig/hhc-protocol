{
  "name": "directory_tree",
  "title": "Directory Tree",
  "description": "Recursive directory listing with depth and entry caps. Prefer over repeated file_list calls.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "path": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute root path on the selected client."
      },
      "max_depth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 5
      },
      "max_entries": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "default": 500
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
