{
  "name": "process_output",
  "title": "Read Process Output",
  "description": "Reads buffered stdout/stderr from a process handle using cursors, so callers never re-fetch the whole log. Pass back the cursors from the previous call.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "process_id"
    ],
    "properties": {
      "process_id": {
        "type": "string",
        "pattern": "^prc_[0-9a-f]{32}$",
        "description": "Opaque process handle returned by process_start. 128-bit entropy, never parsed."
      },
      "stdout_cursor": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Stdout byte offset to resume from; pass back the cursor from the previous call."
      },
      "stderr_cursor": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Stderr byte offset to resume from; pass back the cursor from the previous call."
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 262144,
        "default": 65536,
        "description": "Maximum bytes to return per call."
      },
      "wait_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30000,
        "default": 0,
        "description": "Long-poll for new output up to this long."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "running",
          "completed",
          "failed",
          "unknown_handle"
        ]
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      },
      "stdout_cursor": {
        "type": "integer"
      },
      "stderr_cursor": {
        "type": "integer"
      },
      "exit_code": {
        "type": [
          "integer",
          "null"
        ]
      },
      "error": {
        "type": "string"
      },
      "stdout_truncated": {
        "type": "boolean"
      },
      "stdout_dropped_bytes": {
        "type": "integer"
      },
      "stderr_truncated": {
        "type": "boolean"
      },
      "stderr_dropped_bytes": {
        "type": "integer"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
