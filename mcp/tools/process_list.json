{
  "name": "process_list",
  "title": "List Processes",
  "description": "Lists process sessions. scope managed shows HHC-tracked sessions (cheap); scope system shows OS processes and can return large tables \u2014 pass limit for interactive use (truncated=true with total_count when cut).",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target client (required for system scope).",
        "x-mcp-header": "Client-Id"
      },
      "scope": {
        "type": "string",
        "enum": [
          "managed",
          "system"
        ],
        "default": "managed"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "Max rows returned (system scope). Omitted = all rows."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "scope": {
        "type": "string"
      },
      "processes": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "error": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "total_count": {
        "type": "integer"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
