{
  "name": "process_list",
  "title": "List Processes",
  "description": "Lists process sessions. scope managed shows HHC-tracked sessions (cheap); scope system shows OS processes and can return large tables — pass limit for interactive use (truncated=true with total_count when cut). Prefer this over shell commands such as ps, tasklist, or Get-Process.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target client (required for system scope).",
        "x-mcp-header": "Client-Id"
      },
      "scope": {
        "type": "string",
        "enum": [
          "managed",
          "system"
        ],
        "default": "managed",
        "description": "managed lists HHC-tracked sessions (cheap); system lists OS processes."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "Max rows returned (system scope). Omitted = all rows."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "completed on success, failed on error."
      },
      "client_id": {
        "type": "string",
        "description": "Echo of the target host id (null when no host was targeted)."
      },
      "job_id": {
        "type": "string",
        "description": "Server job handle for this execution."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Execution time in milliseconds."
      },
      "result": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Requested scope the result refers to."
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "OS process id."
                },
                "ppid": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Parent process id."
                },
                "name": {
                  "type": "string",
                  "description": "Process image name."
                },
                "elapsed": {
                  "type": "string",
                  "description": "Elapsed time as reported by the OS."
                },
                "cpu_percent": {
                  "type": "number",
                  "description": "CPU usage percent."
                },
                "mem_percent": {
                  "type": "number",
                  "description": "Memory usage percent."
                }
              }
            },
            "description": "Process records returned."
          },
          "total_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Total records; may exceed returned records."
          },
          "truncated": {
            "type": "boolean",
            "description": "True when output was cut to bounds."
          }
        },
        "description": "Agent payload for this execution."
      },
      "error": {
        "type": "string",
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
