{
  "name": "process_list",
  "title": "List Processes",
  "description": "Lists process sessions. scope managed shows HHC-tracked sessions; scope system shows OS processes.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target client (required for system scope).",
        "x-mcp-header": "Client-Id"
      },
      "scope": {
        "type": "string",
        "enum": [
          "managed",
          "system"
        ],
        "default": "managed"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "scope": {
        "type": "string"
      },
      "processes": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
