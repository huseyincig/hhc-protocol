{
  "name": "client_list",
  "title": "List Hosts",
  "description": "Lists enrolled HHC hosts using safe inventory metadata for explicit target discovery.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "all",
          "online",
          "offline"
        ],
        "default": "all",
        "description": "Filter hosts by connectivity state."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 100,
        "description": "Maximum hosts to return."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ],
        "description": "completed on success, failed on error."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "clients": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "is_live": {
              "type": "boolean"
            },
            "profile": {
              "type": "string"
            },
            "last_seen": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "description": "Host inventory records."
      },
      "error": {
        "type": "string",
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
