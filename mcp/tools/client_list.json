{
  "name": "client_list",
  "title": "List Hosts",
  "description": "Lists enrolled HHC hosts using safe inventory metadata for explicit target discovery.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "all",
          "online",
          "offline"
        ],
        "default": "all",
        "description": "Filter hosts by connectivity state."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 100,
        "description": "Maximum hosts to return."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ],
        "description": "completed on success, failed on error."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "clients": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "pattern": "^hhc_[0-9a-f]{64}$",
              "description": "Target HHC client identity."
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Display name."
            },
            "hostname": {
              "type": [
                "string",
                "null"
              ],
              "description": "Host machine name."
            },
            "platform": {
              "type": [
                "string",
                "null"
              ],
              "description": "OS platform (e.g. linux, win32, darwin)."
            },
            "arch": {
              "type": [
                "string",
                "null"
              ],
              "description": "CPU architecture."
            },
            "client_version": {
              "type": [
                "string",
                "null"
              ],
              "description": "Running agent version."
            },
            "status": {
              "type": "string",
              "enum": [
                "online",
                "offline"
              ],
              "description": "Current connectivity state."
            },
            "last_seen": {
              "type": [
                "string",
                "null"
              ],
              "description": "Last contact timestamp."
            },
            "transport": {
              "type": [
                "string",
                "null"
              ],
              "description": "Live transport name when connected."
            },
            "transport_scheme": {
              "type": [
                "string",
                "null"
              ],
              "description": "Transport scheme when connected."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tool capabilities advertised by the host."
            }
          }
        },
        "description": "Host inventory records."
      },
      "error": {
        "type": "string",
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
