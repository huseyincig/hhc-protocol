{
  "name": "file_list",
  "title": "List Directory",
  "description": "Lists the immediate contents of an allowlisted client directory. Use directory_tree when a recursive hierarchy is needed.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "path": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute path of the directory to list on the selected client."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 200,
        "description": "Maximum entries to return."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "is_directory": {
              "type": "boolean"
            },
            "size_bytes": {
              "type": "integer"
            },
            "modified_at": {
              "type": "string"
            }
          }
        }
      },
      "total_entries": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
