{
  "name": "file_list",
  "title": "List Directory",
  "description": "Lists the immediate contents of an allowlisted client directory. Use directory_tree when a recursive hierarchy is needed.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "path": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute path of the directory to list on the selected client."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 200,
        "description": "Maximum entries to return."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ],
        "description": "completed on success, failed on error."
      },
      "client_id": {
        "type": "string",
        "description": "Echo of the target host id (null when no host was targeted)."
      },
      "job_id": {
        "type": "string",
        "description": "Server job handle for this execution."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Execution time in milliseconds."
      },
      "result": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Listed directory path."
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Entry file name."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "directory",
                    "file",
                    "symlink",
                    "other"
                  ],
                  "description": "Entry kind."
                },
                "size": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Size in bytes, null when stat failed."
                },
                "mtime": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Modification timestamp, null when stat failed."
                }
              }
            },
            "description": "Directory entries (one level)."
          },
          "truncated": {
            "type": "boolean",
            "description": "True when output was cut to bounds."
          }
        },
        "description": "Agent payload for this execution."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
