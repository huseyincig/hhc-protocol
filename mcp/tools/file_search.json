{
  "name": "file_search",
  "title": "Search Files",
  "description": "Searches text files below an allowlisted client path with bounded work.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path",
      "query"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68
      },
      "path": {
        "type": "string",
        "maxLength": 4096
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 100
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "query": {
        "type": "string"
      },
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "line_number": {
              "type": "integer"
            },
            "preview": {
              "type": "string"
            }
          }
        }
      },
      "total_matches": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  }
}
