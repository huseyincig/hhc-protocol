{
  "name": "file_search",
  "title": "Search Files",
  "description": "Searches text files below an allowlisted client path with bounded work. Prefer this over shell grep, find, Select-String, or similar search commands.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path",
      "query"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "path": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute path of the directory tree to search on the selected client."
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Text to search for."
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 100,
        "description": "Maximum matches to return."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ],
        "description": "completed on success, failed on error."
      },
      "client_id": {
        "type": "string",
        "description": "Echo of the target host id (null when no host was targeted)."
      },
      "job_id": {
        "type": "string",
        "description": "Server job handle for this execution."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Execution time in milliseconds."
      },
      "result": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Searched root path."
          },
          "query": {
            "type": "string",
            "description": "Echo of the search query."
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Absolute file path."
                },
                "line": {
                  "type": "integer",
                  "description": "1-based line number of the match."
                },
                "preview": {
                  "type": "string",
                  "description": "Match context preview."
                }
              }
            },
            "description": "Matches found."
          },
          "files_searched": {
            "type": "integer",
            "description": "Number of files scanned."
          },
          "truncated": {
            "type": "boolean",
            "description": "True when output was cut to bounds."
          },
          "timed_out": {
            "type": "boolean",
            "description": "True when the time budget expired."
          }
        },
        "description": "Agent payload for this execution."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
