{
  "name": "log_follow_start",
  "title": "Start Log Follow",
  "description": "Opens a stateful tail handle on a client log file; read incrementally with log_follow_read. Prefer over repeated log_read polling.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "source"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "source": {
        "type": "string",
        "description": "Log source (client log files in v1)."
      },
      "path": {
        "type": "string",
        "description": "Explicit log file path (optional)."
      },
      "max_lines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 200
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "handle": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "cursor": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
