{
  "name": "privileged_shell_exec",
  "title": "Privileged Remote Shell",
  "description": "Runs an elevated root/administrator command on a supported HHC client via the cryptographic privileged helper daemon. client_id and command are mandatory. Highest-risk operation: grants root/administrator execution. Explicit Admin authorization applies and user confirmation is required before execution.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "command"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68
      },
      "command": {
        "type": "string"
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300,
        "default": 30
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "exit_code": {
        "type": "integer"
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      },
      "duration_ms": {
        "type": "integer"
      },
      "elevation_tier": {
        "type": "string",
        "enum": [
          "root",
          "administrator"
        ]
      },
      "error": {
        "type": "string"
      }
    }
  }
}
