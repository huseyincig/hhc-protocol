{
  "name": "process_terminate",
  "title": "Terminate Process",
  "description": "Graceful SIGTERM first; force=true escalates to hard kill. High-risk on system PIDs: prefer managed handles.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "process_id"
    ],
    "properties": {
      "process_id": {
        "type": "string",
        "pattern": "^prc_[0-9a-f]{32}$",
        "description": "Opaque process handle returned by process_start. 128-bit entropy, never parsed."
      },
      "force": {
        "type": "boolean",
        "default": false
      },
      "grace_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30000,
        "description": "Grace window before SIGKILL escalation (ignored when force=true).",
        "default": 5000
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "error": {
        "type": "string"
      },
      "signal": {
        "type": "string"
      },
      "graceful": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
