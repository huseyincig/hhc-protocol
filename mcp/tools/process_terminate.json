{
  "name": "process_terminate",
  "title": "Stop Process",
  "description": "Graceful SIGTERM first; force=true escalates to hard kill. Only processes launched via process_start in this boot can be terminated (opaque prc_ handles); anything else fails with UNKNOWN_HANDLE.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "process_id"
    ],
    "properties": {
      "process_id": {
        "type": "string",
        "pattern": "^prc_[0-9a-f]{32}$",
        "description": "Opaque process handle returned by process_start. 128-bit entropy, never parsed."
      },
      "force": {
        "type": "boolean",
        "default": false,
        "description": "Escalate from graceful SIGTERM to hard kill."
      },
      "grace_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30000,
        "description": "Grace window before SIGKILL escalation (ignored when force=true).",
        "default": 5000
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ],
        "description": "completed on success, failed on error."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "client_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "Echo of the target host id (null for handle-scoped calls)."
      },
      "process_id": {
        "type": "string",
        "description": "Echo of the process handle."
      },
      "signal": {
        "type": [
          "string",
          "null"
        ],
        "description": "Termination signal used."
      },
      "forced": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Whether force-kill was used."
      },
      "graceful": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Whether the process exited gracefully."
      },
      "terminated": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Whether the process is gone."
      },
      "note": {
        "type": "string",
        "description": "Informational note (e.g. offline handle release)."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
