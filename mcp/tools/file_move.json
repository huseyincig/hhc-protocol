{
  "name": "file_move",
  "title": "Move File",
  "description": "Moves a regular-file or symlink leaf between allowlisted paths on an explicitly selected HHC client after host-policy admission.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "source",
      "destination"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "source": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute source path (file or symlink leaf) on the selected client."
      },
      "destination": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute destination path on the selected client."
      },
      "overwrite": {
        "type": "boolean",
        "default": false,
        "description": "Replace the destination if it already exists."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "destination": {
        "type": "string"
      },
      "moved": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
