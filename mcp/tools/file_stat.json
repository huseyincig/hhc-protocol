{
  "name": "file_stat",
  "title": "File Information",
  "description": "Returns size, timestamps and mode for a path without reading content. Use before edits or transfers.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "path": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute path on the selected client."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "size_bytes": {
        "type": [
          "integer",
          "null"
        ]
      },
      "mtime": {
        "type": [
          "string",
          "null"
        ]
      },
      "mode": {
        "type": [
          "string",
          "null"
        ]
      },
      "is_directory": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
