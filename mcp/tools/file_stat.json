{
  "name": "file_stat",
  "title": "File Information",
  "description": "Returns size, timestamps and mode for a path without reading content. Use before edits or transfers.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "path"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "path": {
        "type": "string",
        "maxLength": 4096,
        "description": "Absolute path on the selected client."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "completed on success, failed on error.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "client_id": {
        "type": "string",
        "description": "Echo of the target host id (null when no host was targeted)."
      },
      "job_id": {
        "type": "string",
        "description": "Server job handle for this execution."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Execution time in milliseconds."
      },
      "result": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Resolved absolute path."
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Size of the filesystem entry in bytes."
          },
          "mtime": {
            "type": [
              "string",
              "null"
            ],
            "description": "Modification timestamp."
          },
          "mode": {
            "type": "string",
            "description": "Permission bits in octal."
          },
          "is_directory": {
            "type": "boolean",
            "description": "Whether the path is a directory."
          }
        },
        "description": "Agent payload for this execution."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
