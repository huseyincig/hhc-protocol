{
  "name": "log_read",
  "title": "Read Logs",
  "description": "Reads an allowlisted log source from a selected HHC client on demand. Log content is not retained in central SQLite.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "source"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "source": {
        "type": "string",
        "enum": [
          "client",
          "mcp-server",
          "mcp-tunnel"
        ],
        "description": "Which log to read: HHC client, MCP server, or tunnel."
      },
      "lines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 200,
        "description": "Number of recent lines to return."
      },
      "contains": {
        "type": "string",
        "maxLength": 200,
        "description": "Return only lines containing this text."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "count": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
