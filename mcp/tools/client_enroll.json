{
  "name": "client_enroll",
  "title": "Enroll Host",
  "description": "Creates a new HHC client identity and one-time visible enrollment script for a supported platform.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "platform"
    ],
    "properties": {
      "platform": {
        "type": "string",
        "enum": [
          "any",
          "windows",
          "linux",
          "macos"
        ],
        "description": "Target platform for the enrollment instructions."
      },
      "name": {
        "type": "string",
        "maxLength": 128,
        "description": "Display name for the new host."
      },
      "server_url": {
        "type": "string",
        "maxLength": 2048,
        "description": "Hub URL the new host will connect to."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "enrollment_token": {
        "type": "string"
      },
      "host_id": {
        "type": "string"
      },
      "expires_at": {
        "type": "string"
      },
      "install_commands": {
        "type": "object",
        "properties": {
          "linux": {
            "type": "string"
          },
          "windows": {
            "type": "string"
          },
          "macos": {
            "type": "string"
          }
        }
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
