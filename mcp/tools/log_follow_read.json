{
  "name": "log_follow_read",
  "title": "Read Followed Log",
  "description": "Returns log bytes appended since cursor.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "handle"
    ],
    "properties": {
      "handle": {
        "type": "string",
        "pattern": "^log_[0-9a-f]{32}$",
        "description": "Opaque log-follow handle returned by log_follow_start."
      },
      "cursor": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 262144,
        "default": 65536
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "cursor": {
        "type": "integer"
      },
      "eof": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
