{
  "name": "service_status",
  "title": "Service Status",
  "description": "Reads status for an allowlisted service unit on a client.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "unit"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68
      },
      "unit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "unit": {
        "type": "string"
      },
      "state": {
        "type": "string",
        "enum": [
          "running",
          "stopped",
          "failed",
          "unknown"
        ]
      },
      "details": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  }
}
