{
  "name": "service_status",
  "title": "Service Status",
  "description": "Reads status for an allowlisted service unit on a client.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id",
      "unit"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      },
      "unit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Service unit name on the selected client (this tool uses unit; service_start/stop/restart use service for the same value)."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ],
        "description": "completed on success, failed on error."
      },
      "client_id": {
        "type": "string",
        "description": "Echo of the target host id (null when no host was targeted)."
      },
      "job_id": {
        "type": "string",
        "description": "Server job handle for this execution."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Execution time in milliseconds."
      },
      "result": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "description": "Queried unit name."
          },
          "resolved_unit": {
            "type": "string",
            "description": "Platform-resolved unit identifier."
          },
          "platform": {
            "type": "string",
            "description": "linux, darwin or win32."
          },
          "active": {
            "type": "string",
            "description": "Active state (active, inactive, unknown)."
          },
          "enabled": {
            "type": "string",
            "description": "Enabled state (enabled, disabled, unknown)."
          },
          "active_exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Probe exit code."
          },
          "enabled_exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Probe exit code (linux only)."
          },
          "raw_output": {
            "type": "string",
            "description": "Raw probe output (darwin/win32 only)."
          }
        },
        "description": "Agent payload for this execution."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
