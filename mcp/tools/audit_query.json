{
  "name": "audit_query",
  "title": "Search Audit Events",
  "description": "Reads the caller tenant audit trail with filters. Read-only introspection over the platform audit chain. Note: tool executions are recorded under action \"tool.execute\" with the tool name in payload.tool — filter by action \"tool.execute\", not by tool name.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Filter by action name (e.g. \"tool.execute\" for tool calls; the tool name itself lives in payload.tool)."
      },
      "actor": {
        "type": "string",
        "description": "Filter by actor id/email."
      },
      "status": {
        "type": "string",
        "description": "Filter by record status."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50,
        "description": "Maximum events to return."
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Number of events to skip for pagination."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "completed on success, failed on error.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Audit record id."
            },
            "tenant_id": {
              "type": "string",
              "description": "Owning tenant."
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "description": "Hash-chain sequence number."
            },
            "actor_type": {
              "type": "string",
              "description": "Actor class (user, agent, system, api_key, token)."
            },
            "actor_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Actor id when known."
            },
            "actor_email": {
              "type": [
                "string",
                "null"
              ],
              "description": "Actor email when known."
            },
            "ip_address": {
              "type": [
                "string",
                "null"
              ],
              "description": "Actor IP when known."
            },
            "action": {
              "type": "string",
              "description": "Action name."
            },
            "resource_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Resource class when applicable."
            },
            "resource_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Resource id when applicable."
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Correlated request id when known."
            },
            "created_at": {
              "type": "string",
              "description": "Record timestamp."
            }
          }
        },
        "description": "Audit records returned."
      },
      "total": {
        "type": "integer",
        "description": "Total available; may exceed returned entries."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Machine-readable error code when status is failed."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "limit": {
        "type": "integer",
        "description": "Applied page size."
      },
      "offset": {
        "type": "integer",
        "description": "Applied page offset."
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
