{
  "name": "client_forget",
  "title": "Forget Host",
  "description": "Removes an offline, idle HHC client and its retained central history. This does not uninstall software from the host.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "client_id"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "pattern": "^hhc_[0-9a-f]{64}$",
        "minLength": 68,
        "maxLength": 68,
        "description": "Target HHC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string"
      },
      "client_id": {
        "type": "string"
      },
      "forgotten": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
