{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HHC public browser/egress policy",
  "type": "object",
  "properties": {
    "allow_schemes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "http:",
        "https:"
      ]
    },
    "deny_schemes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cloud_metadata_hosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "private_network_allowed": {
      "type": "boolean"
    },
    "script_execution_allowed": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": true
}
